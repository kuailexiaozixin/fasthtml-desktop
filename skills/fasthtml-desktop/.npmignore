# Machine-local or regenerable content — never ship inside the npm package.
# npm applies these rules inside the package.json "files" allowlist, so the
# 25 upstream snapshots under examples/ still ship while their caches do not.

# version control / CI metadata
.git/
.gitattributes
.github/

# shared Python virtualenv (regenerated by sync_upstream.py; pins a host path)
.venv/
**/.venv/
venv/
**/venv/

# stale pre-repull backups kept only on the maintainer's machine
.backup_*/
**/.backup_*/

# interpreter and packaging caches
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
**/*.egg-info/
dist/
**/dist/
build/
**/build/
output/
**/output/
*.spec

# tooling caches
.impeccable/
**/.impeccable/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/

# Runtime state and logs.
# NOTE: *.sqlite / data/ are deliberately NOT excluded — manifest.json declares
# them runnable assets to preserve ("data/ *.sqlite static/ 保留（可运行资产）").
*.log
**/*.log

# dependencies
node_modules/
**/node_modules/

# editors and OS
.idea/
.vscode/
.DS_Store
**/.DS_Store
Thumbs.db
