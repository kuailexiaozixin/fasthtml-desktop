"""dev_main.py — 开发模式入口（热重载 + 浏览器预览）

使用方式：
    uv run python src/dev_main.py
    浏览器打开 http://127.0.0.1:5001

特点：
    - uvicorn reload=True，代码修改后自动重载
    - 不启动 pywebview 窗口，直接在浏览器预览

打包前切换到：
    python src/main.py  # pywebview 桌面模式
"""
import os
import sys

SRC_DIR = os.path.dirname(os.path.abspath(__file__))
if SRC_DIR not in sys.path:
    sys.path.insert(0, SRC_DIR)

try:
    from app import app
except ImportError:
    package = None
    for name in sorted(os.listdir(SRC_DIR)):
        candidate = os.path.join(SRC_DIR, name)
        if os.path.isdir(candidate) and not name.startswith("_") \
                and os.path.isfile(os.path.join(candidate, "app.py")):
            package = name
            break
    if package is None:
        raise ImportError("未找到 app 模块：检查 src/app.py 或 src/<pkg>/app.py")
    module = __import__(f"{package}.app", fromlist=["app"])
    app = getattr(module, "app")

if __name__ == "__main__":
    import uvicorn
    port = int(os.environ.get("PORT", 5001))
    print(f"[DEV] 开发模式: http://127.0.0.1:{port}")
    print("[DEV] 代码修改后自动重载 (Ctrl+C 停止)")
    uvicorn.run(app, host="127.0.0.1", port=port, reload=True)