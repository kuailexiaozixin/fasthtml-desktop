# --- FastMeet --------------------------------------------------------------
FASTMEET_ADMIN_EMAIL=admin@fastmeet.example
FASTMEET_ADMIN_PASSWORD=FastMeet2026$
FASTMEET_SECRET=
FASTMEET_PORT=5015
FASTMEET_ENV_LABEL=FastMeet
FASTMEET_DB=

# --- AI (agenda/summary + chat) -------------------------------------------
# MODEL_PROVIDER: xai | openai | anthropic | google. Slash-commands need no key.
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Live video (room media layer) -----------------------------------------
# jitsi (default, zero-config, uses public meet.jit.si) | livekit
MEET_MEDIA_PROVIDER=jitsi
JITSI_DOMAIN=meet.jit.si
# LiveKit (only if MEET_MEDIA_PROVIDER=livekit): server URL + API credentials
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://meet.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# FastSME local accounts and transactional email
FASTSME_AUTH_DB=
FASTSME_PUBLIC_URL=https://meet.fastsme.com
POSTMARK_API_TOKEN=
FROM_EMAIL=info@predictivelabs.ai

# Public reads need no credential; set this to enable bearer-token API writes.
FASTSME_API_TOKEN=
