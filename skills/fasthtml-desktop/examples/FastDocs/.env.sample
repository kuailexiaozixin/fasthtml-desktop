# --- FastDocs --------------------------------------------------------------
FASTDOCS_ADMIN_EMAIL=admin@fastdocs.example
FASTDOCS_ADMIN_PASSWORD=FastDocs2026$
FASTDOCS_SECRET=
FASTDOCS_PORT=5016
FASTDOCS_ENV_LABEL=FastDocs
FASTDOCS_DB=

# --- AI (document generation + chat) --------------------------------------
# MODEL_PROVIDER: xai | openai | anthropic | google.
# Slash-commands (/docs, /templates) work with no key; generation + chat need one.
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://docs.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# FastSME local accounts and transactional email
FASTSME_AUTH_DB=
FASTSME_PUBLIC_URL=https://docs.fastsme.com
POSTMARK_API_TOKEN=
FROM_EMAIL=info@predictivelabs.ai

# Public reads need no credential; set this to enable bearer-token API writes.
FASTSME_API_TOKEN=
