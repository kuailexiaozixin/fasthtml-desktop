# FastFPA
FASTFPA_ENV=development
FASTFPA_PORT=5018
FASTFPA_DB=
FASTFPA_SECRET=
FASTFPA_PUBLIC_URL=http://localhost:5018

# FastOffice preferred suite sign-in
FASTOFFICE_SSO_SECRET=

# Google OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5018/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# Explanatory/drafting assistant; deterministic commands work without a key
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=

# Public reads need no credential; enables reviewable scenario-draft POST only
FASTSME_API_TOKEN=
