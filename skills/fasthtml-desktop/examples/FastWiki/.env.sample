FASTWIKI_ENV=development
FASTWIKI_PORT=5022
FASTWIKI_SECRET=change-me
FASTWIKI_DB=data/fastwiki.sqlite
FASTWIKI_UPLOAD_DIR=data/uploads
FASTWIKI_ATTACHMENT_BACKEND=local
FASTWIKI_MAX_UPLOAD_MB=20
FASTOFFICE_URL=http://localhost:5020
FASTOFFICE_SSO_SECRET=
FASTSME_API_TOKEN=
FASTWIKI_ADMIN_EMAILS=julian.kaljuvee@mymedicalgateway.com
FASTWIKI_AI_QUERY_LIMIT=5
FASTWIKI_AI_PROVIDER=xai
FASTWIKI_AI_MODEL=grok-4.3
FASTWIKI_AI_BASE_URL=https://api.x.ai/v1
XAI_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
