# FastLMS environment variables
# Copy to .env and fill in values

# --- Database -------------------------------------------------------------
# 桌面示例默认 SQLite，零外部服务：不设任何变量即落到 data/fastlms.sqlite。
# FASTLMS_DB        单文件库的绝对/相对路径（优先级最高，desktop.py 会自动设为 data/）
# FASTLMS_DATA_DIR  数据目录（未设 FASTLMS_DB 时，库落在 <该目录>/fastlms.sqlite）
# FASTLMS_SCHEMA    表名限定前缀。SQLite 留空即用内置别名 main；PostgreSQL 设为 fastlms。
FASTLMS_DB=
FASTLMS_DATA_DIR=
FASTLMS_SCHEMA=

# 仅在还原上游 PostgreSQL 行为时填写（需 pip install psycopg2-binary，
# 并把 FASTLMS_SCHEMA 设为 fastlms）：
# DB_URL=postgresql://user:password@localhost:5432/your_database
DB_URL=

# Session secret (change in production)
SESSION_SECRET=fastlms-change-me-in-production

# --- Demo login（登录弹窗账号，desktop.py/main.py 启动时幂等播种为已验证）------
FASTLMS_ADMIN_EMAIL=admin@fastlms.example
FASTLMS_ADMIN_PASSWORD=FastLMS2026$

# LLM provider for AI Tutor chat (xai | openai | anthropic)
MODEL_PROVIDER=xai
DEFAULT_MODEL=grok-4-1-fast-reasoning

# API keys (only the one matching MODEL_PROVIDER is needed)
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lms.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# FastSME local accounts and transactional email
FASTSME_AUTH_DB=
FASTSME_PUBLIC_URL=https://lms.fastsme.com
POSTMARK_API_TOKEN=
FROM_EMAIL=info@predictivelabs.ai

# Public reads need no credential; set this to enable bearer-token API writes.
FASTSME_API_TOKEN=
