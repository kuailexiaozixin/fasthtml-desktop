      "output/",
      ".impeccable/",
      "__pycache__/",
      "node_modules/",
      "dist/",
      ".git/",
      "*.pyc"
    ],
    "media": [
      "docs/*.pdf",
      "docs/*.pptx",
      "docs/*.gif",
      "docs/*.mp4",
      "screenshots/"
    ],
    "_note": "mandatory 必排（纯工具/测试/缓存产物）；media 建议排（参考媒体，深度清理时启用）；data/ *.sqlite static/ 保留（可运行资产）"
  },
