[project]
name = "{{APP_NAME}}"
version = "0.1.0"
description = "FastHTML Desktop Application"
requires-python = ">=3.10"
dependencies = [
    "python-fasthtml>=0.6.0",
    "pywebview>=5.0",
    "pythonnet>=3.0",
    "uvicorn>=0.30",
    "requests>=2.31",
    "pydantic>=2.0",
]

[project.scripts]
myapp = "main:start"

[tool.ruff]
line-length = 120
target-version = "py310"
